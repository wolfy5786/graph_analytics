# --- Datasets (large; download / convert locally) ---
# Keep the directory; ignore graph payloads and conversions.
# Tiny fixtures in tests/tiny_graphs/ are NOT ignored — commit those.
data/**
!data/.gitkeep
!data/README.md

# --- Results: keep CSVs + figures; drop heavy profiler dumps ---
results/**/*.nsys-rep
results/**/*.nsys-rep.sqlite
results/**/*.qdrep
results/**/*.sqlite
results/**/*.ncu-rep
results/**/*_ncu*/
results/**/r???hs/
results/**/r???mem/
results/**/*_hs/
results/**/*_mem/
results/**/*.vtune
results/**/*.amplxe*
*.nsys-rep
*.ncu-rep
*.qdrep

# Optional: uncomment if figures are always regenerated from CSVs
# results/**/*.png
# results/**/*.pdf
# results/**/*.svg

# Keep result directory placeholders
!results/.gitkeep
!results/**/.gitkeep

